# Шаблон для <MAILCOW_DIR>/data/conf/nginx/mailshare-files.conf — check-mailcow.sh подставляет адрес PUBLIC_HOST из .env
# Публичный сайт скачивания: наружу открыто только скачивание по ссылке.
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name {{PUBLIC_HOST}};

  ssl_certificate     /etc/ssl/mail/cert.pem;
  ssl_certificate_key /etc/ssl/mail/key.pem;

  # Если Pingvin остановлен, почта продолжит работать (здесь будет 502)
  resolver 127.0.0.11 valid=30s;
  set $pingvin http://mailshare-pingvin:3000;

  client_max_body_size 1m;   # загрузка через этот адрес не нужна
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;

  # Страница ссылки
  location ~ ^/(s|share)/[A-Za-z0-9_-]+/?$ {
    limit_except GET { deny all; }
    proxy_pass $pingvin;
  }

  # Оформление интерфейса
  location /_next/       { limit_except GET { deny all; } proxy_pass $pingvin; }
  location /img/         { limit_except GET { deny all; } proxy_pass $pingvin; }
  location = /manifest.json { proxy_pass $pingvin; }
  location = /favicon.ico   { proxy_pass $pingvin; }
  location = /sw.js { return 404; }   # фоновый помощник Pingvin не нужен

  # Сведения о share
  location ~ ^/api/shares/[A-Za-z0-9_-]+$ {
    limit_except GET { deny all; }
    proxy_pass $pingvin;
  }

  # Готов ли архив «скачать всё»
  location ~ ^/api/shares/[A-Za-z0-9_-]+/metaData$ {
    limit_except GET { deny all; }
    proxy_pass $pingvin;
  }

  # Пропуск посетителя
  location ~ ^/api/shares/[A-Za-z0-9_-]+/token$ {
    limit_except POST { deny all; }
    client_max_body_size 1k;
    proxy_pass $pingvin;
  }

  # Скачивание файла и архива (files/<id> и files/zip)
  location ~ ^/api/shares/[A-Za-z0-9_-]+/files/[A-Za-z0-9-]+$ {
    limit_except GET { deny all; }
    proxy_buffering off;   # не складывать гигабайты на диск Nginx
    limit_rate 10m;        # не больше 10 МБ/с на одно скачивание
    proxy_pass $pingvin;
  }

  # Всё остальное закрыто: вход, админка, загрузка
  location / { return 404; }
}
