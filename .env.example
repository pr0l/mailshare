# Скопируйте в .env, заполните и выполните: chmod 600 .env
# Значения пишите без кавычек; в паролях не используйте символ $.

# --- Адреса ---
# Адрес почты Mailcow (на нём работает страница загрузки /mailshare/)
MAIL_HOST=mail.example.com
# Публичный адрес для скачивания (отдельное DNS-имя на этот же сервер)
PUBLIC_HOST=files.example.com
# Каталог Mailcow на сервере
MAILCOW_DIR=/opt/mailcow-dockerized

# --- Лимиты (общие для Gateway и Pingvin; без строки — значение по умолчанию) ---
# Лимит одной отправки, все файлы вместе, байт: 300000000 = 300 МБ, 2000000000 = 2 ГБ
MAX_SHARE_BYTES=300000000
# Срок жизни ссылки, дней
SHARE_EXPIRATION_DAYS=180
# Сколько дней Pingvin хранит файлы после истечения ссылки (доступны только администратору)
FILE_RETENTION_DAYS=30
# Сколько один сотрудник может загрузить за сутки, ГБ
DAILY_QUOTA_GB=10
# Одновременных отправок на сотрудника
MAX_ACTIVE_UPLOADS=3
# Файлов в одной отправке
MAX_FILES_PER_SHARE=100
# Имя PDF-вложения
PDF_NAME=download-files.pdf
# Часовой пояс дат в блоке со ссылкой и PDF (часов от UTC)
DISPLAY_TZ_OFFSET=3

# --- Pingvin ---
# Название в заголовке страницы скачивания
PINGVIN_APP_NAME=Email file storage
# Служебная учётная запись, от имени которой Gateway загружает файлы
PINGVIN_USER=mailshare
PINGVIN_PASSWORD=
# Первый администратор Pingvin: создаётся при самом первом запуске (пустая база).
# Для нового сервера: true и пароль; после первого входа — false и удалите пароль.
PINGVIN_INIT_ADMIN=false
PINGVIN_ADMIN_EMAIL=admin@example.com
PINGVIN_ADMIN_PASSWORD=
